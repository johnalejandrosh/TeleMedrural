# Copie este archivo a .env y complete los valores.

# --- PostgreSQL (prisma.config.ts y lib/server/db.ts arman la conexión con estas variables)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nombre_base
DB_USER=usuario
DB_PASSWORD=contraseña
# Esquema donde viven las tablas (también se acepta DB_SCHEMA)
DB_SHEMA=telemedicina

# --- Seed (`npm run db:seed`)
# Administrador inicial (por defecto admin@telemedrural.co / demo1234)
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=
# "false" para no crear el personal, los pacientes y los casos de demostración
# SEED_DEMO=true
